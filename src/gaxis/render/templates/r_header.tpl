# @DOCSTRING@
#
# Generated by gaxis @VERSION@ — this script is the deliverable, not a build artifact.
# Edit it freely: change labels, colours, statistics, or the plotting code itself.
# Backend: ggplot2. Data: @DATA_NAME@
# Run: Rscript figure.R

suppressPackageStartupMessages({
  library(ggplot2)
})

DATA_PATH <- @DATA_PATH@
OUT_DIR <- @OUT_DIR@
STEM <- @STEM@
SEP <- @SEP@
BASE_PT <- @BASE_PT@
LABEL_PT <- @LABEL_PT@
TITLE_PT <- @TITLE_PT@
SPINE_WIDTH <- @SPINE_WIDTH@
LINE_WIDTH <- @LINE_WIDTH@
MARKER_SIZE <- @MARKER_SIZE@
FONT_FAMILY <- @FONT@
DPI <- @DPI@
FIG_W_MM <- @FIG_W@
FIG_H_MM <- @FIG_H@

# Encoding intent. Keep column names here if you edit the data layout.
SPEC <- list(
  x = @X@,
  y = @Y@,
  hue = @HUE@,
  yerr = @YERR@,
  weight = @WEIGHT@,
  annotations = c(@ANNOTATIONS@),
  color_map = @COLOR_MAP@,
  rotate_labels = @ROTATE_LABELS@,
  title = @TITLE@,
  xlabel = @XLABEL@,
  ylabel = @YLABEL@,
  annotate = @ANNOTATE@,
  formats = c(@FORMATS@)
)

COLORS <- c(@COLORS@)
FILL_VALUES <- if (is.null(SPEC$hue)) COLORS[1] else COLORS
LEGEND_POSITION <- if (is.null(SPEC$hue)) "none" else "right"
DODGE <- if (is.null(SPEC$hue)) "identity" else position_dodge(width = 0.8)
# labs() with NULL labels would be dropped by ggplot2, so filter them out explicitly.
LABS <- do.call(
  labs,
  Filter(Negate(is.null), list(x = SPEC$xlabel, y = SPEC$ylabel, title = SPEC$title, fill = SPEC$hue))
)
LABS_COLOUR <- do.call(
  labs,
  Filter(Negate(is.null), list(x = SPEC$xlabel, y = SPEC$ylabel, title = SPEC$title, colour = SPEC$hue))
)
MISSING <- c("", "NA", "n/a", "nan", "None")

raw <- read.delim(
  DATA_PATH,
  sep = SEP,
  check.names = FALSE,
  stringsAsFactors = FALSE,
  na.strings = MISSING,
  quote = "\"",
  comment.char = ""
)

levels_of <- function(values) unique(as.character(values[!is.na(values)]))

# ggplot2 interprets `linewidth` in lwd units (1/96 inch), which renders ~2.13x
# heavier than the same number in points (matplotlib) — measured on agg_png.
# Convert so both backends draw strokes of equal weight for the same preset.
pt_to_lwd <- function(pt) pt / 2.134

tidy <- data.frame(x = as.character(raw[[SPEC$x]]), stringsAsFactors = FALSE)
if (!is.null(SPEC$y)) {
  tidy$y <- suppressWarnings(as.numeric(raw[[SPEC$y]]))
} else {
  tidy$y <- rep(1, nrow(tidy))  # count mode: one unit per observation
}
if (!is.null(SPEC$hue)) tidy$hue <- as.character(raw[[SPEC$hue]])
if (!is.null(SPEC$yerr)) tidy$err <- suppressWarnings(as.numeric(raw[[SPEC$yerr]]))

tidy$x <- factor(tidy$x, levels = levels_of(tidy$x))
if (!is.null(SPEC$hue)) tidy$hue <- factor(tidy$hue, levels = levels_of(tidy$hue))
x_is_numeric <- is.numeric(raw[[SPEC$x]])

# Group means and SD (or the mean of a supplied error column) — identical
# statistics to the matplotlib backend, so the two backends stay comparable.
summarise_groups <- function(df) {
  key <- if (is.null(SPEC$hue)) list(df$x) else list(df$x, df$hue)
  means <- aggregate(
    df$y,
    by = key,
    FUN = if (is.null(SPEC$y)) function(v) length(v) else function(v) mean(v, na.rm = TRUE)
  )
  spread <- if (is.null(SPEC$y)) {
    rep(0, nrow(means))
  } else if (!is.null(SPEC$yerr)) {
    aggregate(df$err, by = key, FUN = mean, na.rm = TRUE)$x
  } else {
    aggregate(df$y, by = key, FUN = function(v) if (length(v) > 1) sd(v) else 0)$x
  }
  if (is.null(SPEC$hue)) {
    names(means) <- c("x", "mean")
    means$hue <- factor("all")
  } else {
    names(means) <- c("x", "hue", "mean")
  }
  means$err <- ifelse(is.na(spread), 0, spread)
  means
}

theme_paper <- theme_classic(base_size = BASE_PT, base_family = FONT_FAMILY) +
  theme(
    axis.text = element_text(colour = "black", size = BASE_PT),
    axis.text.x = if (SPEC$rotate_labels > 0) {
      element_text(colour = "black", size = BASE_PT, angle = SPEC$rotate_labels, hjust = 1)
    } else {
      element_text(colour = "black", size = BASE_PT)
    },
    axis.title = element_text(colour = "black", size = LABEL_PT),
    axis.line = element_line(linewidth = pt_to_lwd(SPINE_WIDTH), colour = "black"),
    axis.ticks = element_line(linewidth = pt_to_lwd(SPINE_WIDTH), colour = "black"),
    plot.title = element_text(size = TITLE_PT, hjust = 0, face = "plain"),
    legend.title = element_text(size = BASE_PT),
    legend.text = element_text(size = BASE_PT),
    legend.key.size = unit(3, "mm"),
    plot.margin = margin(2, 2, 2, 2, unit = "mm")
  )
theme_set(theme_paper)
update_geom_defaults("errorbar", list(linewidth = pt_to_lwd(0.5)))

# Panel composition (M4): sourcing with GAXIS_PANEL_SOURCE=1 yields `p` without
# writing files, so patchwork/cowplot can arrange panels without re-rendering them.
save_all <- function(plot) {
  dir.create(OUT_DIR, recursive = TRUE, showWarnings = FALSE)
  for (fmt in SPEC$formats) {
    target <- file.path(OUT_DIR, paste0(STEM, ".", fmt))
    if (fmt == "pdf") {
      ggsave(target, plot = plot, width = FIG_W_MM, height = FIG_H_MM, units = "mm",
             device = grDevices::cairo_pdf)
    } else if (fmt == "svg") {
      ggsave(target, plot = plot, width = FIG_W_MM, height = FIG_H_MM, units = "mm",
             device = svglite::svglite)
    } else if (fmt == "png") {
      ggsave(target, plot = plot, width = FIG_W_MM, height = FIG_H_MM, units = "mm",
             dpi = DPI, device = ragg::agg_png, bg = "white")
    } else if (fmt == "tiff") {
      ggsave(target, plot = plot, width = FIG_W_MM, height = FIG_H_MM, units = "mm",
             dpi = DPI, device = ragg::agg_tiff, bg = "white", compression = "lzw")
    } else {
      stop(paste("unsupported format:", fmt))
    }
    message("wrote ", target)
  }
}
