def load_rows(path: Path) -> list[dict[str, str]]:
    """One row per observation, exactly as delivered by the upstream export."""
    with path.open(newline="", encoding="utf-8-sig") as handle:
        return list(csv.DictReader(handle, delimiter=DELIMITER))


def categories(rows: list[dict[str, str]], column: str) -> list[str]:
    """Unique levels in first-appearance order (stable across backends)."""
    seen: list[str] = []
    for row in rows:
        value = row[column]
        if value not in seen:
            seen.append(value)
    return seen


def numeric_column(rows: list[dict[str, str]], column: str) -> bool:
    """True when the first non-missing value parses as a number."""
    for row in rows:
        value = row[column]
        if value not in MISSING:
            try:
                float(value)
            except ValueError:
                return False
            return True
    return False


def summarise(
    rows: list[dict[str, str]],
    x: str,
    y: str | None,
    hue: str | None,
    yerr: str | None,
) -> tuple[list[dict[str, object]], list[str], list[str | None]]:
    """Group means and errors, so the matplotlib and ggplot2 backends agree."""
    levels = categories(rows, x)
    groups = categories(rows, hue) if hue else [None]
    stats: list[dict[str, object]] = []
    for level in levels:
        for group in groups:
            subset = [r for r in rows if r[x] == level and (group is None or r[hue] == group)]
            if y is None:
                stats.append(
                    {"level": level, "group": group, "mean": float(len(subset)), "err": 0.0, "n": len(subset)}
                )
                continue
            subset = [r for r in subset if r[y] not in MISSING]
            if not subset:
                continue
            values = [float(r[y]) for r in subset]
            if yerr:
                errors = [float(r[yerr]) for r in subset if r[yerr] not in MISSING]
                spread = float(np.mean(errors)) if errors else 0.0
            else:
                spread = float(np.std(values, ddof=1)) if len(values) > 1 else 0.0
            stats.append(
                {"level": level, "group": group, "mean": float(np.mean(values)), "err": spread, "n": len(values)}
            )
    return stats, levels, groups


def finish(ax, *, xlabel: str | None = None, ylabel: str | None = None) -> None:
    """Titles, labels, legend, and the journal-format save loop.

    The legend sits outside the axes: a journal figure must not cover data with
    its own key, and this matches the ggplot2 layout of the R backend.
    """
    if SPEC["title"]:
        ax.set_title(SPEC["title"], loc="left")
    xlabel = SPEC["xlabel"] if xlabel is None else xlabel
    ylabel = SPEC["ylabel"] if ylabel is None else ylabel
    if xlabel:
        ax.set_xlabel(xlabel)
    if ylabel:
        ax.set_ylabel(ylabel)
    if SPEC.get("rotate_labels", 0):
        for label in ax.get_xticklabels():
            label.set_rotation(SPEC["rotate_labels"])
            label.set_ha("right")
    if SPEC["hue"] and ax.get_legend() is None:
        ax.legend(
            title=SPEC["hue"],
            loc="center left",
            bbox_to_anchor=(1.01, 0.5),
            borderaxespad=0.0,
        )
    # Panel composition (M4): GAXIS_PANEL_SOURCE=1 leaves the figure open for import
    # by a composition script instead of writing files.
    if os.environ.get("GAXIS_PANEL_SOURCE") == "1":
        return
    OUT_DIR.mkdir(parents=True, exist_ok=True)
    for fmt in SPEC["formats"]:
        target = OUT_DIR / f"{STEM}.{fmt}"
        fig.savefig(target, format=fmt)
        print(f"wrote {target}")
    plt.close(ax.figure)
